{
  "name": "ai-desktop-mate",
  "version": "1.0.3",
  "description": "Lumi - AI-powered desktop companion (3D VRM avatar)",
  "main": "src/main/main.js",
  "scripts": {
    "build": "esbuild src/renderer/main.js --bundle --outfile=src/renderer/renderer.bundle.js --format=iife --platform=browser",
    "watch": "esbuild src/renderer/main.js --bundle --outfile=src/renderer/renderer.bundle.js --format=iife --platform=browser --watch",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "icon": "node scripts/make-icon.js",
    "test": "node --test tests/helpers.test.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "node scripts/dist.js",
    "rebuild:pty": "node scripts/rebuild-pty.js"
  },
  "author": "thomasnrs <thomasnrs@hotmail.com>",
  "license": "MIT",
  "build": {
    "appId": "com.lumi.desktop",
    "productName": "Lumi",
    "copyright": "Copyright © 2026",
    "publish": {
      "provider": "github",
      "owner": "thomasnrs",
      "repo": "Lumi_Agent",
      "releaseType": "release"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/main.js",
      "!**/*.map",
      "!**/*.bak"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "cerberia.vrm"
        ]
      },
      {
        "from": "animations",
        "to": "animations",
        "filter": [
          "**/*.vrma"
        ]
      },
      {
        "from": "assets/brand",
        "to": "assets/brand",
        "filter": [
          "**/*.png",
          "**/*.svg"
        ]
      },
      "icone.png"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@vscode/ripgrep/**"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumi",
      "artifactName": "Lumi-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Sua companheira de desktop com IA",
      "maintainer": "thomasnrs <thomasnrs@hotmail.com>"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.21.0",
    "javascript-obfuscator": "^5.4.3",
    "jimp": "^0.22.12",
    "png-to-ico": "^3.0.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.186",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@pixiv/three-vrm": "^3.4.0",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "mongodb": "^7.3.0",
    "mysql2": "^3.22.5",
    "node-pty": "^1.1.0",
    "pg": "^8.21.0",
    "socket.io": "^4.8.3",
    "three": "^0.169.0",
    "uiohook-napi": "^1.5.5",
    "uuid": "^14.0.1",
    "ws": "^8.21.0"
  }
}
